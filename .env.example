# Copy to .env for local use, or set these as Railway service variables.

# --- Database -------------------------------------------------------------
# Leave unset to use a local SQLite file (fine for local dev, NOT for Railway:
# Railway's disk is wiped on every deploy/restart, so your log would vanish).
#
# For a durable deployment, point this at Postgres. On Railway, add the
# Postgres plugin and reference its URL, e.g. set:
#   ROBOCALL_DB_URL=${{Postgres.DATABASE_URL}}
# The app also auto-detects a standard DATABASE_URL if present.
# ROBOCALL_DB_URL=postgresql://user:pass@host:5432/dbname

# --- Authentication -------------------------------------------------------
# Set a password to require HTTP Basic auth on the whole app. If unset, the
# app runs WITHOUT authentication (anyone with the URL can read/add entries).
# ROBOCALL_USERNAME=admin
# ROBOCALL_PASSWORD=change-me-to-something-long

# --- Local run (run.sh only) ----------------------------------------------
# HOST=127.0.0.1
# PORT=8000
